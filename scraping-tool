#!/bin/sh
#
# Runs the scraping tool inside Docker, so that python does not have to be
# installed.
#
# Variables:
#   MY_UID / MY_GID     which user the container writes files as
#   DOCKER_COMPOSE_CMD  e.g. 'docker-compose' or 'podman compose'

set -eu

# Work from the repository, not from wherever this was called.
REPO_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$REPO_ROOT"

MY_UID=${MY_UID:-$(id -u)}
MY_GID=${MY_GID:-$(id -g)}
DOCKER_COMPOSE_CMD=${DOCKER_COMPOSE_CMD:-docker compose}
export MY_UID MY_GID

if [ "${1:-}" = "build" ]; then
  shift
  exec $DOCKER_COMPOSE_CMD build "$@"
fi

export COMPOSE_PROGRESS=quiet

# Keep the TTY when run interactively.
TTY_FLAG=''
[ -t 1 ] || TTY_FLAG='-T'

exec $DOCKER_COMPOSE_CMD run --rm $TTY_FLAG scrapy_service "$@"
